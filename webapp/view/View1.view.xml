<mvc:View controllerName="livedigveh.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <VBox id="_IDGenVBox1">
        <!-- <HBox id="_IDGenHBox1">
            <Select
            id="columnSelect"
            width="200px"
            selectedKey="SoldToPartyName">

            <items>
                <core:Item id="_DDItemSoldToPartyName" key="SoldToPartyName" text="Sold To Party Name" />
                <core:Item id="_DDItemBillToPartyName" key="BillToPartyName" text="Bill To Party Name" />
                <core:Item id="_DDItemMaterial" key="Material" text="Material" />
            </items>
            </Select>

            <SearchField id="_IDGenSearchField"
            width="100%"
            placeholder="Search..."
            liveChange="onSearch" />
        </HBox> -->
        <Table id="vehicalTable" items="{path: '/DigitalVehicleSlsOrdItem_2'}" growing="true"
            growingThreshold="20"
            growingScrollToLoad="true">
                        <columns>
                            <!-- <Column id="colMaterial">
                                <Text id="txtColMaterial" text="Material"/>
                            </Column> -->
                        <Column id="_IDGenColumn">
                            <VBox id="_IDGenVBox2">
                                <Text id="_IDGenText" text="Material" />
                                <Input id="_IDGenInput1" liveChange="onColumnFilter" placeholder="Filter" width="100%">
                                    <customData>
                                        <core:CustomData key="field" value="Material" />
                                    </customData>
                                </Input>
                            </VBox>
                        </Column>

                            <!-- <Column id="colSoldToPartyName">
                                <Text id="txtColSoldToPartyName" text="Sold To Party Name"/>
                            </Column> -->

                            <Column id="_colSoldToPartyName">
                                <VBox id="_IDGenVBoxSoldToPartyName">
                                    <Text id="_IDGenTextSoldToPartyName" text="Sold To Party Name" />
                                    <Input id="_IPSoldToPartyName" liveChange="onColumnFilter" placeholder="Filter" width="100%">
                                        <customData>
                                            <core:CustomData key="field" value="SoldToPartyName" />
                                        </customData>
                                    </Input>
                                </VBox>
                            </Column>
                            <!-- <Column id="colBillToPartyName">
                                <Text id="txtColBillToPartyName" text="Bill To Party Name"/>
                            </Column> -->

                            <Column id="_colBillToPartyName">
                                <VBox id="_IDGenVBoxBillToPartyName">
                                    <Text id="_IDGenTextBillToPartyName" text="Bill To Party Name" />
                                    <Input id="_IPBillToPartyName" liveChange="onColumnFilter" placeholder="Filter" width="100%">
                                        <customData>
                                            <core:CustomData key="field" value="BillToPartyName" />
                                        </customData>
                                    </Input>
                                </VBox>
                            </Column>
                            <Column id="_IDColumnActions">
                                <Text id="_IDActions" text="Actions" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="productListItem">
                                <cells>
                                    <Text id="txtMaterial" text="{Material}" />
                                    <Text id="txtSoldToPartyName" text="{SoldToPartyName}" />
                                    <Text id="txtBillToPartyName" text="{BillToPartyName}" />
                                    <Button id="_IDDelButton"
                                        text="Delete"
                                        type="Reject"
                                        press="onDeleteSingle" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
            </VBox>
    </Page>
</mvc:View>